  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 604</b></color></size>\n<b>Harmandir Sahib (the Golden Temple), Amritsar</b>\n<size=74%>Founded 1581\u20131604; gilded early 19th century\n<i>Marble and gilded copper</i>\nIn situ, Amritsar</size>\n<size=70%><line-height=110%>\nThe holiest gurdwara of Sikhism was built by Guru Arjan, who installed the Adi Granth here in 1604. Doors on all four sides welcome everyone, and its community kitchen feeds tens of thousands of people free every day. Maharaja Ranjit Singh covered its upper storeys in gilded copper.</size>\n<size=50%><color=#8A8A8A>Photo: This picture has been taken by Oleg Yunakov. Contact e-ma... / CC BY-SA 3.0 / Wikimedia Commons</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
