      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 602</b></color></size>\n<b>Jantar Mantar, Jaipur</b>\n<size=74%>1724\u20131735\n<i>Masonry, stone and brass</i>\nIn situ, Jaipur (UNESCO World Heritage Site)</size>\n<size=70%><line-height=110%>\nMaharaja Sawai Jai Singh II built five astronomical observatories in north India. The one at Jaipur has 19 instruments, including the Samrat Yantra, a giant sundial that tells local time to an accuracy of about two seconds. It continued a long Indian tradition of astronomy going back to Aryabhata.</size>\n<size=50%><color=#8A8A8A>Photo: Sudipta Maulik / CC BY-SA 4.0 / Wikimedia Commons</color></size>"
  m_isRightToLeft: 0
