  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KioskScreen
  font: {fileID: 11400000, guid: c43a2009fbd354dac999710313fe0abc, type: 2}
  accent: {r: 0.3529412, g: 0.5411765, b: 0.627451, a: 1}
  mapSprite: {fileID: 21300000, guid: 1634ca45fb36b4c709a0112b36eaea91, type: 3}
  wingId: W6
  sectionTitle: Themes of Indian History
  period: From antiquity to today
  questions:
  - text: Where was the first summit of the Non-Aligned Movement held in 1961?
    options:
    - Bandung
    - Belgrade
    - Cairo
    - New Delhi
    answer: 1
    why: The first Non-Aligned summit took place in Belgrade in 1961.
  - text: In which year was the Indian Space Research Organisation founded?
    options:
    - 1958
    - 1962
    - 1969
    - 1975
    answer: 2
    why: ISRO was founded in 1969 from Vikram Sarabhai's vision.
  - text: Which ancient treatise on performance is attributed to Bharata?
    options:
    - Arthashastra
    - Natyashastra
    - Kamasutra
    - Abhijnanashakuntalam
    answer: 1
    why: Bharata's Natyashastra is the ancient treatise on performance.
  - text: Where did Dr B. R. Ambedkar and his followers embrace Buddhism in 1956?
    options:
    - Sarnath
    - Bodh Gaya
    - Nagpur
    - Mumbai
    answer: 2
    why: The 1956 conversion ceremony took place at Nagpur.
  - text: Who introduced the rupiya, ancestor of today's rupee?
    options:
    - Akbar
    - Samudragupta
    - Sher Shah Suri
    - Ashoka
    answer: 2
    why: Sher Shah Suri introduced the silver rupiya.
  - text: Which article of the Constitution abolished untouchability?
    options:
    - Article 14
    - Article 17
    - Article 21
    - Article 370
    answer: 1
    why: Article 17 abolished untouchability.
  entries:
  - year: 450
    label: "5th \u2013 12th century CE"
    title: Nalanda Mahavihara
