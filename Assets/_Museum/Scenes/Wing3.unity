  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 305</b></color></size>\n<b>A page from the Akbarnama</b>\n<size=74%>c. 1590\u20131595\n<i>Opaque watercolour and gold on paper</i>\nVarious museum collections</size>\n<size=70%><line-height=110%>\nThe Akbarnama, 'Book of Akbar', is the official history of the third Mughal emperor, written by his minister Abul Fazl. Teams of court artists illustrated it with vivid scenes of battles, hunts and court life, blending Persian, Indian and European ideas into a new Mughal style.</size>"
