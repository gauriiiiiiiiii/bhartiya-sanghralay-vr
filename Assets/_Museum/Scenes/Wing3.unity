  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 306</b></color></size>\n<b>The Taj Mahal, Agra</b>\n<size=74%>1632 \u2013 c. 1653\n<i>White Makrana marble inlaid with semi-precious stones</i>\nIn situ, Agra (UNESCO World Heritage Site)</size>\n<size=70%><line-height=110%>\nThe Mughal emperor Shah Jahan built this tomb for his wife Mumtaz Mahal, who died in 1631. Thousands of craftsmen worked for over twenty years on the marble mausoleum, its gardens, mosque and guest house. Its inlaid stonework and perfect symmetry made it a symbol of India across the world.</size>\n<size=50%><color=#8A8A8A>Photo: Yann; edited by King of Hearts / CC BY-SA 4.0 / Wikimedia Commons</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
