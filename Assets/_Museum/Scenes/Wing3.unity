MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1157514890}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32a1abd8e617d414a9d5784c5cb3e6a6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KioskScreen
  font: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
  accent: {r: 0.70980394, g: 0.39607844, b: 0.2901961, a: 1}
  mapSprite: {fileID: 21300000, guid: 1634ca45fb36b4c709a0112b36eaea91, type: 3}
  wingId: W3
  sectionTitle: Medieval India
  period: "750 \u2013 1707"
  questions:
  - text: Where did Prithviraj Chauhan defeat Muhammad of Ghor in 1191?
    options:
    - Panipat
    - Tarain
    - Khanwa
    - Talikota
    answer: 1
    why: Prithviraj won the first battle of Tarain in 1191 but lost there in 1192.
  - text: Which dynasty built the Brihadishvara temple at Thanjavur?
    options:
    - Hoysalas
    - Pandyas
    - Kakatiyas
    - Cholas
    answer: 3
    why: The Imperial Cholas built the Brihadishvara temple and sent naval expeditions overseas.
  - text: Who founded the Mamluk, or Slave, dynasty in 1206?
    options:
    - Iltutmish
    - Balban
    - Qutbuddin Aibak
    - Alauddin Khalji
    answer: 2
    why: Qutbuddin Aibak founded the dynasty; Iltutmish later consolidated it.
  - text: Who is the only woman among the twelve Alvars?
    options:
    - Andal
    - Mirabai
    - Karaikkal Ammaiyar
    - Rudramadevi
    answer: 0
    why: Andal is the only woman among the Alvars; Karaikkal Ammaiyar was a Nayanar.
  - text: Whom did Babur defeat at the First Battle of Panipat in 1526?
    options:
    - Rana Sanga
    - Sher Shah Suri
    - Ibrahim Lodi
    - Hemu
    answer: 2
    why: Babur defeated Ibrahim Lodi at Panipat, founding the Mughal empire.
  - text: Where was Shivaji crowned Chhatrapati in 1674?
    options:
    - Pune
    - Raigad
    - Bijapur
    - Srirangapatna
    answer: 1
    why: Shivaji was crowned Chhatrapati at Raigad in 1674.
