  m_Script: {fileID: 11500000, guid: 9541d86e2fd84c1d9990edf0852d74ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 405</b></color></size>\n<b>Sikandar Bagh, Lucknow, photographed by Felice Beato</b>\n<size=74%>1858\n<i>Albumen silver print</i>\nVarious collections</size>\n<size=70%><line-height=110%>\nThe photographer Felice Beato took this picture of the Sikandar Bagh in Lucknow a few months after British troops stormed it in November 1857, during the relief of the besieged Residency. It is one of the earliest photographs of the aftermath of war \u2013 a reminder of the violence of the uprising.</size>\n<size=50%><color=#8A8A8A>Photo: Unknown / CC0 / Wikimedia Commons</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
