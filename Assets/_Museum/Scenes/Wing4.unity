      u: 0.3272
      v: 0.1718
  - year: 1757
    label: Battle fought 23 June 1757; painted c. 1760
    title: Clive meeting Mir Jafar after the Battle of Plassey
    credit: 'Photo: Francis Hayman / Public domain / Wikimedia Commons'
    target: {fileID: 639879787}
    photo: {fileID: 21300000, guid: af312532b914b424a9a9418cf51813f0, type: 3}
    places:
