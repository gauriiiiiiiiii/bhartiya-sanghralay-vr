      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 405</b></color></size>\n<b>Sikandar Bagh, Lucknow, photographed by Felice Beato</b>\n<size=74%>1858\n<i>Albumen silver print</i>\nVarious collections</size>\n<size=70%><line-height=110%>\nThe photographer Felice Beato took this picture of the Sikandar Bagh in Lucknow a few months after British troops stormed it in November 1857, during the relief of the besieged Residency. It is one of the earliest photographs of the aftermath of war \u2013 a reminder of the violence of the uprising.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
  m_sharedMaterial: {fileID: 3495093604678870679, guid: 723364797c8904a93956dad57186ed9d, type: 2}
