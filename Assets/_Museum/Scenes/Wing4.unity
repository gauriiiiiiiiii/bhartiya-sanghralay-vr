  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 406</b></color></size>\n<b>Raja Ram Mohan Roy</b>\n<size=74%>1772\u20131833\n<i>Portrait, oil on canvas</i>\nBristol Museum and Art Gallery</size>\n<size=70%><line-height=110%>\nRam Mohan Roy, often called the father of the Indian Renaissance, founded the Brahmo Sabha in 1828 to promote a reformed faith. He campaigned against sati, the burning of widows, which was banned in Bengal in 1829, and argued for modern education and a free press. He died in Bristol in 1833.</size>\n<size=50%><color=#8A8A8A>Photo: anonymous / Public domain / Wikimedia Commons</color></size>"
  m_isRightToLeft: 0
