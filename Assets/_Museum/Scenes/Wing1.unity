  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 102</b></color></size>\n<b>The 'Priest-King'</b>\n<size=74%>c. 2000\u20131900 BCE\n<i>Fired steatite, 17.5 cm high</i>\nNational Museum of Pakistan, Karachi</size>\n<size=70%><line-height=110%>\nFound at Mohenjo-daro in the mid-1920s, this bearded man wears a band around his head and a robe decorated with trefoil patterns that were once filled with red paste. Archaeologists nicknamed him the 'Priest-King', but nobody knows who he really was \u2013 the Indus script has never been deciphered.</size>\n<size=50%><color=#8A8A8A>Photo: Mamoon Mengal / CC BY-SA 1.0 / Wikimedia Commons</color></size>"
