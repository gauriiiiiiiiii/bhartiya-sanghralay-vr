      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 110</b></color></size>\n<b>Painted storage jar (replica)</b>\n<size=74%>c. 2600\u20131900 BCE\n<i>Replica of wheel-thrown red ware painted in black</i>\nReplica made for this museum</size>\n<size=70%><line-height=110%>\nHarappan potters threw large jars on the wheel, coated them with a red slip and painted them in black with bands, intersecting circles and leaf patterns. Jars like this stored grain, oil and water in Indus houses. This replica is based on vessels excavated at Harappa and Mohenjo-daro.</size>\n<size=50%><color=#8A8A8A>Replica made for this museum</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
