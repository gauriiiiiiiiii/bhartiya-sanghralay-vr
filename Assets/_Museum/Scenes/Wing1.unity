  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 103</b></color></size>\n<b>The 'Dancing Girl'</b>\n<size=74%>c. 2300\u20131750 BCE\n<i>Bronze, lost-wax casting, 10.5 cm high</i>\nNational Museum, New Delhi</size>\n<size=70%><line-height=110%>\nOnly 10.5 centimetres tall, this young woman stands with one hand on her hip and her left arm covered in bangles. She was found at Mohenjo-daro in 1926 and is one of the finest metal sculptures of the Indus Civilisation, cast about four thousand years ago.</size>"
  m_isRightToLeft: 0
