  m_text: "<size=130%><b>Galleries</b></size>\n\n<b>Ancient India</b>  <size=85%><color=#C9C2B6>c. 1.5 million years ago \u2013 321 BCE</color></size>\n<size=85%>West side, left doorway</size>\n<b>Classical India</b>  <size=85%><color=#C9C2B6>321 BCE \u2013 750 CE</color></size>\n<size=85%>West side, right doorway</size>\n<b>Medieval India</b>  <size=85%><color=#C9C2B6>750 \u2013 1707</color></size>\n<size=85%>North side, left doorway</size>\n<b>Colonial India</b>  <size=85%><color=#C9C2B6>1498 \u2013 1885</color></size>\n<size=85%>North side, right doorway</size>\n<b>Freedom and the Republic</b>  <size=85%><color=#C9C2B6>1885 \u2013 1950</color></size>\n<size=85%>East side, left doorway</size>\n<b>Themes of Indian History</b>  <size=85%><color=#C9C2B6>From antiquity to today</color></size>\n<size=85%>East side, right doorway</size>"
