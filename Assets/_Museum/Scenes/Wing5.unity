    title: Subhas Chandra Bose
    credit: 'Photo: Amiya Gopal Dutta / Public domain / Wikimedia Commons'
    target: {fileID: 111873792}
    photo: {fileID: 21300000, guid: 8fa25d6acf1354042b143654d0dfca0c, type: 3}
    places:
    - name: Moirang, Manipur
      u: 0.8269
