  m_Script: {fileID: 11500000, guid: 32a1abd8e617d414a9d5784c5cb3e6a6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KioskScreen
  font: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
  accent: {r: 0.8784314, g: 0.627451, b: 0.2509804, a: 1}
  mapSprite: {fileID: 21300000, guid: 1634ca45fb36b4c709a0112b36eaea91, type: 3}
  wingId: W5
  sectionTitle: Freedom and the Republic
  period: "1885 \u2013 1950"
  questions:
  - text: Where was the Indian National Congress founded in December 1885?
    options:
    - Calcutta
    - Bombay
    - Madras
    - Poona
    answer: 1
    why: The first Congress session met in Bombay in December 1885.
  - text: Why did Gandhi call off the Non-Cooperation Movement in 1922?
    options:
    - "The Gandhi\u2013Irwin Pact"
    - The violence at Chauri Chaura
    - The Lahore Congress
    - The Poona Pact
    answer: 1
    why: He suspended it after the violence at Chauri Chaura.
  - text: What was the slogan of the Indian National Army under Subhas Chandra Bose?
    options:
    - Do or die
    - Delhi Chalo
    - Inquilab Zindabad
    - Vande Mataram
    answer: 1
    why: Bose rallied the INA with the call Delhi Chalo.
  - text: Where was the All-India Muslim League founded in 1906?
    options:
    - Lahore
    - Aligarh
    - Dhaka
    - Karachi
    answer: 2
    why: The League was founded in Dhaka in 1906.
  - text: What was the 1948 military action that integrated Hyderabad called?
    options:
    - Operation Vijay
    - Operation Polo
    - Operation Flood
    - Operation Blue Star
    answer: 1
    why: India launched Operation Polo in September 1948.
  - text: Which 1973 case established that the basic structure of the Constitution cannot be destroyed?
    options:
    - Golaknath case
    - Kesavananda Bharati case
    - Minerva Mills case
    - Maneka Gandhi case
    answer: 1
    why: The Supreme Court laid down the basic structure doctrine in Kesavananda Bharati.
  entries:
  - year: 1885
    label: "28\u201331 December 1885"
    title: The first Indian National Congress
    credit: 'Photo: Unknown authorUnknown author / Public domain / Wikimedia Commons'
    target: {fileID: 1382772220}
    photo: {fileID: 21300000, guid: ec5f4f6b33342400b914b8c10d99a5bf, type: 3}
    places:
    - name: Bombay
      u: 0.2453
      v: 0.3886
  - year: 1915
    label: "1869\u20131948"
    title: Mahatma Gandhi
    credit: 'Photo: Elliott &amp; Fry / Public domain / Wikimedia Commons'
    target: {fileID: 1267742799}
    photo: {fileID: 21300000, guid: 8ba2c2f14f0a54b4e955d4d36c7a99f4, type: 3}
    places:
    - name: Sabarmati Ashram, Ahmedabad
      u: 0.2383
      v: 0.5087
  - year: 1930
    label: "12 March \u2013 6 April 1930"
    title: The Salt March
    credit: 'Photo: Yann (talk) / Public domain / Wikimedia Commons'
    target: {fileID: 1728995274}
    photo: {fileID: 21300000, guid: bd05dcdf7cd7b4edbb7557638b94bb5f, type: 3}
    places:
    - name: Dandi
      u: 0.2444
      v: 0.445
  - year: 1929
    label: "1907\u20131931"
    title: Bhagat Singh
