  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 510</b></color></size>\n<b>A spinning wheel, or charkha (replica)</b>\n<size=74%>1920s\u20131940s\n<i>Replica in wood and cotton thread</i>\nReplica made for this museum</size>\n<size=70%><line-height=110%>\nGandhi urged every Indian to spin cotton every day. Spinning khadi \u2013 hand-spun, hand-woven cloth \u2013 was a way to boycott British mill cloth, give work to villagers and show self-reliance. In 1921 a spinning wheel was placed at the centre of a proposed national flag, the forerunner of the Ashoka Chakra on today's tricolour.</size>\n<size=50%><color=#8A8A8A>Replica made for this museum</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
  m_sharedMaterial: {fileID: 3495093604678870679, guid: 723364797c8904a93956dad57186ed9d, type: 2}
