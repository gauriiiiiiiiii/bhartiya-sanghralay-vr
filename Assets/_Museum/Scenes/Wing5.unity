      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 505</b></color></size>\n<b>Subhas Chandra Bose</b>\n<size=74%>1897\u20131945\n<i>Photograph</i>\nVarious collections</size>\n<size=70%><line-height=110%>\nTwice elected president of the Congress, Subhas Chandra Bose broke with Gandhi over methods and escaped from British house arrest in 1941. In South-East Asia he led the Indian National Army, which fought alongside Japan in north-east India in 1944.</size>\n<size=50%><color=#8A8A8A>Photo: Amiya Gopal Dutta / Public domain / Wikimedia Commons</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
