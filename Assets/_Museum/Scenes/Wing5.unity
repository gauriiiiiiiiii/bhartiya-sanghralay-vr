      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 503</b></color></size>\n<b>The Salt March</b>\n<size=74%>12 March \u2013 6 April 1930\n<i>Photograph</i>\nVarious collections</size>\n<size=70%><line-height=110%>\nGandhi and 78 followers walked about 385 kilometres from Sabarmati Ashram to the sea at Dandi to make salt in defiance of the British salt tax. The march drew worldwide attention, civil disobedience spread across India, and tens of thousands of people were arrested.</size>\n<size=50%><color=#8A8A8A>Photo: Yann (talk) / Public domain / Wikimedia Commons</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
