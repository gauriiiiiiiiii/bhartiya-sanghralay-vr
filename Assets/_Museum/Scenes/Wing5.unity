      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 502</b></color></size>\n<b>Mahatma Gandhi</b>\n<size=74%>1869\u20131948\n<i>Photograph</i>\nVarious collections</size>\n<size=70%><line-height=110%>\nMohandas Karamchand Gandhi returned from South Africa in 1915 and transformed the freedom movement with satyagraha \u2013 non-violent resistance. He led the Non-Cooperation Movement of 1920\u201322, the Salt March of 1930 and the Quit India Movement of 1942, and campaigned for Hindu\u2013Muslim unity and against untouchability.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
