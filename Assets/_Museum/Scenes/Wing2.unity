      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 203</b></color></size>\n<b>The Great Stupa at Sanchi</b>\n<size=74%>3rd century BCE \u2013 1st century CE\n<i>Brick core cased in stone; carved sandstone gateways</i>\nIn situ, Sanchi, Madhya Pradesh (UNESCO World Heritage Site)</size>\n<size=70%><line-height=110%>\nAshoka built the first brick stupa here to enshrine relics of the Buddha. It was later enlarged and cased in stone, and four magnificent gateways (toranas) were added, carved with stories from the Buddha's past and present lives.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
  m_sharedMaterial: {fileID: 3495093604678870679, guid: 723364797c8904a93956dad57186ed9d, type: 2}
  m_fontSharedMaterials: []
