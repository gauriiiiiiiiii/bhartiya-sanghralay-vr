  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 207</b></color></size>\n<b>The Shore Temple, Mamallapuram</b>\n<size=74%>c. 700\u2013728 CE\n<i>Granite</i>\nIn situ, Mamallapuram, Tamil Nadu (UNESCO World Heritage Site)</size>\n<size=70%><line-height=110%>\nBuilt under the Pallava king Narasimhavarman II, the Shore Temple is one of the earliest structural stone temples in South India. Its stepped towers anticipate the great temples of the Cholas. It stands beside the Bay of Bengal.</size>\n<size=50%><color=#8A8A8A>Photo: Vyacheslav Argenberg / CC BY 4.0 / Wikimedia Commons</color></size>"
