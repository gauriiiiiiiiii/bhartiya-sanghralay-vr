  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 205</b></color></size>\n<b>Gold coin of Samudragupta</b>\n<size=74%>c. 335\u2013375 CE\n<i>Gold (dinara)</i>\nVarious museum collections</size>\n<size=70%><line-height=110%>\nThe Gupta kings issued fine gold coins called dinaras. On this type Samudragupta is shown seated, playing a veena \u2013 a reminder that he was praised as a poet and musician as well as a conqueror. The Gupta period is often called a classical age of Indian art and learning.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 723364797c8904a93956dad57186ed9d, type: 2}
  m_sharedMaterial: {fileID: 3495093604678870679, guid: 723364797c8904a93956dad57186ed9d, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
