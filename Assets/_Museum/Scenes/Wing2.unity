  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=70%><color=#9A6A2E><b>AUDIO 203</b></color></size>\n<b>The Great Stupa at Sanchi</b>\n<size=74%>3rd century BCE \u2013 1st century CE\n<i>Brick core cased in stone; carved sandstone gateways</i>\nIn situ, Sanchi, Madhya Pradesh (UNESCO World Heritage Site)</size>\n<size=70%><line-height=110%>\nAshoka built the first brick stupa here to enshrine relics of the Buddha. It was later enlarged and cased in stone, and four magnificent gateways (toranas) were added, carved with stories from the Buddha's past and present lives.</size>\n<size=50%><color=#8A8A8A>Photo: Bernard Gagnon / CC BY-SA 3.0 / Wikimedia Commons</color></size>"
  m_isRightToLeft: 0
