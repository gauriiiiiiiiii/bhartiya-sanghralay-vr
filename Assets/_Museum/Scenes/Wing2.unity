  m_Script: {fileID: 11500000, guid: 32a1abd8e617d414a9d5784c5cb3e6a6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KioskScreen
  font: {fileID: 11400000, guid: c43a2009fbd354dac999710313fe0abc, type: 2}
  accent: {r: 0.8509804, g: 0.7019608, b: 0.47843137, a: 1}
  mapSprite: {fileID: 21300000, guid: 1634ca45fb36b4c709a0112b36eaea91, type: 3}
  wingId: W2
  sectionTitle: Classical India
  period: "321 BCE \u2013 750 CE"
  questions:
  - text: Whom did Chandragupta Maurya overthrow to found the Maurya empire?
    options:
    - The Nanda king
    - Seleucus Nicator
    - Pushyamitra Shunga
    - Bimbisara
    answer: 0
    why: He overthrew the Nanda king around 321 BCE.
  - text: Which treatise on statecraft is attributed to Chanakya?
    options:
    - Indica
    - Arthashastra
    - Milindapanha
    - Harshacharita
    answer: 1
    why: The Arthashastra, on statecraft, economy and law, is attributed to Chanakya (Kautilya).
  - text: Which Kushana ruler convened the Fourth Buddhist Council in Kashmir?
    options:
    - Gondophares
    - Kanishka
    - Rudradaman
    - Gautamiputra Satakarni
    answer: 1
    why: Kanishka patronised Buddhism and convened the Fourth Buddhist Council.
  - text: In Sangam poetry, poems of love are called what?
    options:
    - Puram
    - Akam
    - Tinai
    - Nadukal
    answer: 1
    why: Akam poems deal with love; puram with war and public life.
  - text: At which site near Puducherry have Roman pottery and wine jars been excavated?
    options:
    - Arikamedu
    - Korkai
    - Keeladi
    - Kodumanal
    answer: 0
    why: Excavations at Arikamedu revealed Roman pottery and amphorae.
  - text: Which Chinese pilgrim visited India in the reign of Chandragupta II?
    options:
    - Xuanzang
    - Yijing
    - Faxian
    - Song Yun
    answer: 2
    why: Faxian visited India during Chandragupta II's reign.
