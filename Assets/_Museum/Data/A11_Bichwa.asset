  titleMr: "\u092C\u093F\u091A\u0935\u093E"
  panelMr: "\u0935\u093F\u0902\u091A\u0935\u093E\u091A\u094D\u092F\u093E \u0928\u093E\u0902\u0917\u0940\u0935\u0930\u0942\u0928 \u0928\u093E\u0935 \u092A\u0921\u0932\u0947\u0932\u093E \u0935\u0915\u094D\u0930 \u0916\u0902\u091C\u0940\u0930. \u0932\u092A\u0935\u093E\u092F\u0932\u093E \u0938\u094B\u092A\u093E \u0906\u0923\u093F \u091C\u0935\u0933\u091A\u094D\u092F\u093E \u0932\u0922\u093E\u0908\u0924 \u0935\u093E\u092A\u0930\u0932\u093E \u091C\u093E\u0923\u093E\u0930\u093E. (\u092A\u094D\u0930\u0924\u093F\u0915\u0943\u0924\u0940, \u092E\u094B\u0920\u094D\u092F\u093E \u0906\u0915\u093E\u0930\u093E\u0924 \u0926\u093E\u0916\u0935\u0932\u093E \u0906\u0939\u0947.)"
