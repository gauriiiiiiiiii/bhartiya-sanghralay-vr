  titleMr: "\u0938\u093F\u0902\u0939\u093E\u0938\u0928"
  panelMr: "\u0967\u096C\u096D\u096A \u091A\u094D\u092F\u093E \u0930\u093E\u091C\u094D\u092F\u093E\u092D\u093F\u0937\u0947\u0915\u093E\u0924\u0940\u0932 \u092E\u0942\u0933 \u0938\u093F\u0902\u0939\u093E\u0938\u0928 \u0906\u091C \u0909\u092A\u0932\u092C\u094D\u0927 \u0928\u093E\u0939\u0940; \u0935\u0930\u094D\u0923\u0928\u093E\u0902\u092E\u0927\u094D\u092F\u0947 \u091B\u0924\u094D\u0930\u093E\u0916\u093E\u0932\u0940\u0932 \u0938\u0941\u0935\u0930\u094D\u0923 \u0938\u093F\u0902\u0939\u093E\u0938\u0928\u093E\u091A\u093E \u0909\u0932\u094D\u0932\u0947\u0916 \u0906\u0922\u0933\u0924\u094B. \u0939\u0940 \u0915\u0932\u093E\u0924\u094D\u092E\u0915 \u092A\u0941\u0928\u0930\u094D\u0930\u091A\u0928\u093E \u0906\u0939\u0947."
